            position = { x = 6 y = 22 }
            alwaysTransparent = yes

        }
        buttonType = {
            name = "close"
            quadTextureSprite = "GFX_close"
            position = { x= -42 y = 12 }
            orientation = "UPPER_RIGHT"
            shortcut = "ESCAPE"
            clicksound = "back_click"
        }

        # Custom header
        instantTextBoxType = {
            name = "gts_achevement_header"
            font = "malgun_goth_24"
            position = { x = 20 y = 5 }
            maxWidth = 543
            maxHeight = 22
            fixedSize = yes
            alwaysTransparent = yes
        }

        ###_	ALL OF THIS IS HIDDEN OR DISPLACED!	######################################################
        instantTextBoxType = {
            name = "alien_message"
