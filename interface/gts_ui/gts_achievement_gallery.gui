    @gts_achi_w = 560
    @gts_achi_h= 40

    # 标签
    containerWindowType = {
        name = "gts_achievement_option_tab"
        position = { x = 0 y = 0 } size = { width = @gts_achi_w height = @gts_achi_h }
        iconType = { name = hex spriteType = GFX_hex_bg position = { x = -23 y = -18 } alwaysTransparent = yes }
        iconType = { name = line spriteType = GFX_line_medium position = { x = -5 y = 15 } alwaysTransparent = yes }
        buttonType = {
            name = "option_button"
            size = { x = @gts_achi_w y = @gts_achi_h }  position = { x = 0 y = 0 }
            quadTextureSprite = GFX_tiled_window_transparent
            font = cg_16b text = "OPTION_TEXT" format = left borderSize = { x = 5 y = 0 }
            text_offset = { x = 10 y = 0 }
            no_clicksound = yes
        }
        OverlappingElementsBoxType = { name = "trigger_icons" position = { x = 350 y = -1 } size = { x = 30 y = 30 } }
    }
    # 成就
    containerWindowType = {
        name = "gts_achievement_option"
        position = { x = 0 y = 0 } size = { width = @gts_achi_w height = @gts_achi_h }
        #iconType = { name = hex spriteType = GFX_hex_center_bg position = { x = -70 y = -17 } alwaysTransparent = yes }

        buttonType = {
            name = "option_button"
            size = { x = @gts_achi_w y = @gts_achi_h }  position = { x = 0 y = 0 }
            quadTextureSprite = GFX_button_light
            font = cg_16b text = "OPTION_TEXT" format = left
            text_offset = { x = 15 y = 0 }
            no_clicksound = yes
        }
        OverlappingElementsBoxType = { name = "trigger_icons" position = { x = 0 y = -1 } size = { x= 40 y= 40 } }
