            size = { width = 0 height = 0 } # hide portrait window
            iconType = { name = "portrait" spriteType = "GFX_portrait_gamesetup_mask" scale = @portrait_scale position = { x = 2 y = 2 } alwaysTransparent = yes }
            iconType = { name = "black_frame" spriteType = "GFX_diplomacy_portrait_shadow_frame" scale = @portrait_scale alwaysTransparent = yes }
            iconType = { name = "stripes_1" spriteType = "GFX_diplomacy_stripes_2" scale = @portrait_scale alwaysTransparent = yes }
            iconType = { name = "city_frame" spriteType = "GFX_diplomacy_portrait_frame" scale = @portrait_scale alwaysTransparent = yes }
