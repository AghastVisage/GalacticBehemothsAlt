#界面
@outliner_h = 900
@outliner_h_max = 1100
@outliner_w = 600
#
@list_w = 570
@list_box_h = 650
@list_h_max = 890
@list_x = 10
@list_y = 260

guiTypes = {

    ### FACTION OVERVIEW GUI ###

    containerWindowType = {
        name = "gts_achievement_gallery"
        orientation = center
        origo = center
        moveable = yes
        size = { width = @outliner_w height = @outliner_h }

        background = {
            name = "background"
            quadTextureSprite = "GFX_window_background"
        }

        iconType = {
            name = "hex_bg"
