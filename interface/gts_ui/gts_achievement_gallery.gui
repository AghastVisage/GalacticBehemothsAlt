            listboxType = {
                name = "option_list"
                position = { x = @list_x y = @list_y }
                size = { x = @list_w y = @list_box_h } borderSize = { x = 5 y = 5 }
                scrollbarType = "standardlistbox_slider"
                background = GFX_dark_area_cut
                alwaysTransparent = no
                #if_resolution = { min_height = 1440 size = { width = @list_w height = @list_h_max } }
            }
