# GTSS: retain vanilla background entities/animations; disable particles for transparent placeholders.
entity = {
    name = "machineage_frontend_root_entity"
    locator = { name = "loc" position = { 0.0 0.0 0.0 } }

    attach = { loc = "machineage_frontend_attached_entity" }

}


entity = {
    name = "machineage_frontend_attached_entity"
    pdxmesh = "machineage_frontend_mesh"

    default_state = "idle"
    state = { name = "idle"     animation = "idle" animation_speed = 0.60
        #start_event = { node = "root" particle = "fc_01_front_end_fog" keep_particle = yes trigger_once = yes }
    }

    #position = { x= 5 y = 0 }

    scale = 1


}



animation = {
    name = "machineage_frontend_idle_animation"
    file = "machineage_frontend_idle.anim"
}
