entity = {
	name = "gts_skadi_size_blue_aura_level1_entity"
	pdxmesh = "system_plane_collision_mesh"
	locator = { name = "core" position = { 0 0 0 } }

	default_state = "explode"
	state = {
		name = "explode"
		state_time = 30
		looping = no

		event = { time = 0.00 node = "core" particle = "blue_sun_grow_particle" keep_particle = yes trigger_once = yes }
		event = { time = 0.25 node = "core" particle = "star_explosion_1_05_effect" keep_particle = yes trigger_once = yes }
		event = { time = 2.20 node = "core" particle = "star_explosion_shockwave_effect" keep_particle = yes trigger_once = yes }
		event = { time = 6.00 node = "core" particle = "blue_sun_grow_particle" keep_particle = yes trigger_once = yes }

		start_event = { trigger_once = yes sound = { soundeffect = "sfx_star_eater_weapon_hit" } }
		start_event = { trigger_once = yes sound = { soundeffect = "sfx_star_eater_weapon_hit_distance" } }
	}

	scale = 1
	cull_radius = 20000
}

